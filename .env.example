# Django
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=replace-with-a-long-random-value
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000
DJANGO_SECURE_SSL_REDIRECT=False
CADRIA_PORT=8000
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False

# PostgreSQL (Docker Compose)
POSTGRES_DB=cadria
POSTGRES_USER=cadria
POSTGRES_PASSWORD=local-development-only
DATABASE_URL=postgresql://cadria:local-development-only@db:5432/cadria

# Redis / Celery
REDIS_URL=redis://cache:6379/0
CELERY_TASK_ALWAYS_EAGER=False

# Fournisseur IA principal. `groq` donne le meilleur résultat (modèle plus
# grand, réponses plus rapides) mais a besoin d'AI_API_KEY. Sans clé, chaque
# brief bascule automatiquement sur AI_FALLBACK_PROVIDER (ollama, local, sans
# clé) : le projet reste fonctionnel même avant que la clé soit renseignée.
# `demo` reste disponible pour un onboarding encore plus léger (aucun réseau).
AI_PROVIDER=groq
AI_API_KEY=
AI_BASE_URL=https://api.mistral.ai/v1
AI_MODEL=demo-cadria-v1
AI_TIMEOUT_SECONDS=60
AI_MAX_INPUT_CHARS=12000
AI_PROMPT_VERSION=v1

# Fournisseur de secours si le fournisseur principal échoue (indisponibilité,
# quota, réponse invalide, clé manquante, etc.). Vide = aucun secours. `ollama`
# ne demande aucune clé : c'est ce qui garantit qu'un clone sans AI_API_KEY
# reste fonctionnel dès `docker compose up --build`.
AI_FALLBACK_PROVIDER=ollama

# Groq (API compatible OpenAI). Utilisé comme fournisseur principal par défaut
# (AI_PROVIDER=groq) ; peut aussi servir de secours via
# AI_FALLBACK_PROVIDER=groq si un autre principal est choisi. La clé reste
# AI_API_KEY et ne doit jamais être commitée.
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-20b
GROQ_TIMEOUT_SECONDS=60

# Ollama local. Fournisseur de secours par défaut (AI_FALLBACK_PROVIDER=ollama),
# utilisable aussi comme principal via AI_PROVIDER=ollama. Le conteneur ollama
# télécharge automatiquement OLLAMA_MODEL au démarrage s'il est absent : aucune
# commande manuelle n'est nécessaire.
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=qwen2.5:0.5b
OLLAMA_TIMEOUT_SECONDS=120
OLLAMA_NUM_CTX=4096
OLLAMA_KEEP_ALIVE=1m
OLLAMA_PORT=11434
OLLAMA_MEMORY_LIMIT=2g
OLLAMA_CPU_LIMIT=2.0

# Démarrage du conteneur web uniquement
RUN_STARTUP_TASKS=True

# Active le profil Compose `ollama` par défaut, pour que `docker compose up`
# démarre aussi le conteneur ollama sans avoir à passer --profile ollama.
# Nécessaire même avec Groq en principal : c'est ce conteneur que le secours
# (AI_FALLBACK_PROVIDER=ollama) utilise. Ne retirer/vider cette ligne que si le
# secours Ollama n'est pas souhaité du tout (ex. Groq seul, assumé sans filet).
COMPOSE_PROFILES=ollama
